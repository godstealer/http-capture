{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HTTP Capture",
  "version": "0.1.0",
  "identifier": "dev.httpcapture.desktop",
  "build": {
    "beforeDevCommand": "npm run dev --workspace @http-capture/frontend",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace @http-capture/frontend",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HTTP Capture",
        "width": 1440,
        "height": 920,
        "minWidth": 1000,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; object-src 'none'; frame-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCRTc5NDAxOTlCMDIyMEMKUldRTUlyQ1pBWlRuVzJ0Y0l3N2hKNUdVZnpQa053eXFrOVhHQkhHRis0aVppbE9UVzB3RkJYajEK",
      "endpoints": [
        "https://github.com/godstealer/http-capture/releases/download/updater-preview/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
